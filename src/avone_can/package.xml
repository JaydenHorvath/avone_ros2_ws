<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>avone_can</name>
  <version>0.0.0</version>
  <description>AV.ONE CAN interface package containing a CAN-to-ROS bridge node and simulation publishers for wheel speed and steering angle CAN signals.</description>
  <maintainer email="c3350128@uon.edu.au">Jayden Horvath</maintainer>
  <license>Proprietary</license>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
