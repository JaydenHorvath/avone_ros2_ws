<?xml version="1.0"?>
<robot name="trolley">

  <!-- Materials -->
  <material name="mat_blue">
    <color rgba="0.1 0.3 0.9 1.0"/>
  </material>
  <material name="mat_black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>

  <material name="mat_grey">
  <color rgba="0.6 0.6 0.6 1.0"/>
  </material>

  <material name="mat_white">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>

  <!-- Base link -->
  <link name="base_link">
    <visual>
      <!-- base sits 0.30 m above ground -->
      <origin xyz="0 0 0.30" rpy="0 0 0"/>
      <geometry>
        <box size="0.9 0.7 0.05"/>
      </geometry>
      <material name="mat_grey"/>
    </visual>
  </link>


    <joint name="lidar_joint" type="fixed">
        <parent link="base_link"/>
        <child link="lidar_link"/>
         <origin xyz="-0.81 0 0.4" rpy="0 0 3.14"/>
        <!-- <origin xyz="0.6909 0 0.772413" rpy="0 0.4 0"/> -->
    </joint>

    <link name="lidar_link">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.090"/>
            </geometry>
            <material name="mat_black"/>
        </visual>

          <!-- Base plate below LiDAR -->
        <visual>
          <!-- shift down by half the lidar height + half box height -->
          <origin xyz="-0.25 0 -0.065" rpy="0 0 0"/>
          <geometry>
            <box size="0.6 0.12 0.02"/>
          </geometry>
          <material name="mat_grey"/>
        </visual>
     
        <collision>
            <geometry>
                <cylinder radius="0.05" length="0.090"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.05">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>


    <joint name="gps_joint" type="fixed">
        <parent link="base_link"/>
        <child link="gps_link"/>
          <origin xyz="-0.35 0.275 0.35" rpy="0 0 0"/>
    </joint>

  <link name="gps_link">
    <visual>
      <geometry>
        <cylinder radius="0.0625" length="0.085"/>
      </geometry>
      <material name="mat_white"/>
    </visual>
  </link>

      <joint name="gps2_joint" type="fixed">
        <parent link="base_link"/>
        <child link="gps2_link"/>
          <origin xyz="0.35 0.275 0.35" rpy="0 0 0"/>
    </joint>

  <link name="gps2_link">
    <visual>
      <geometry>
        <cylinder radius="0.0625" length="0.085"/>
      </geometry>
      <material name="mat_white"/>
    </visual>
  </link>



  <!-- Wheel parameters -->
  <!-- radius = 0.15 m, width = 0.04 m -->
  <!-- placed so top of wheel nearly meets bottom of chassis -->

  <!-- Front Left Wheel -->
  <link name="wheel_fl">
    <visual>
      <origin xyz="0.25 0.20 0.15" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.04"/>
      </geometry>
      <material name="mat_black"/>
    </visual>
  </link>
  <joint name="joint_wheel_fl" type="fixed">
    <parent link="base_link"/>
    <child link="wheel_fl"/>
  </joint>

  <!-- Front Right Wheel -->
  <link name="wheel_fr">
    <visual>
      <origin xyz="0.25 -0.20 0.15" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.04"/>
      </geometry>
      <material name="mat_black"/>
    </visual>
  </link>
  <joint name="joint_wheel_fr" type="fixed">
    <parent link="base_link"/>
    <child link="wheel_fr"/>
  </joint>

  <!-- Rear Left Wheel -->
  <link name="wheel_rl">
    <visual>
      <origin xyz="-0.25 0.20 0.15" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.04"/>
      </geometry>
      <material name="mat_black"/>
    </visual>
  </link>
  <joint name="joint_wheel_rl" type="fixed">
    <parent link="base_link"/>
    <child link="wheel_rl"/>
  </joint>

  <!-- Rear Right Wheel -->
  <link name="wheel_rr">
    <visual>
      <origin xyz="-0.25 -0.20 0.15" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.04"/>
      </geometry>
      <material name="mat_black"/>
    </visual>
  </link>
  <joint name="joint_wheel_rr" type="fixed">
    <parent link="base_link"/>
    <child link="wheel_rr"/>
  </joint>

</robot>
