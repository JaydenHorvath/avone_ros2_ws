    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Local Odom1
        - /Local Odom1/Shape1
        - /Global Odom1
        - /Global Odom1/Shape1
        - /GPS Odom1
        - /GPS Odom1/Shape1
        - /GPS Odom1/Covariance1
      Splitter Ratio: 0.5
    Tree Height: 1071
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
