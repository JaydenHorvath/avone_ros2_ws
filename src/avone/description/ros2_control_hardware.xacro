<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <ros2_control name="AVONE_ros2_control" type="system">
    <hardware>
      <plugin>avone/AvoneSystemHardware</plugin>

      <!-- Your existing params -->
      <param name="max_steer_angle">0.610865</param>
      <param name="min_steer_angle">-0.610865</param>
      <param name="max_rpm">300</param>
      <param name="can_interface">can0</param>
      <param name="can_baudrate">250000</param>
      <param name="read_timeout_ms">20</param>
      <param name="l_motor_can_id">0x8CF11E05</param>
      <param name="r_motor_can_id">0x8CF11E06</param>
      <param name="steer_can_id">0x0D</param>
      <param name="cmd_l_motor_can_id">0x0B</param>
      <param name="cmd_r_motor_can_id">0x0A</param>
      <param name="cmd_steer_can_id">0x09</param>


    </hardware>

    <!-- front steering -->
    <joint name="LSteer">
      <command_interface name="position"/>
      <state_interface   name="position"/>
    </joint>
    <joint name="RSteer">
      <command_interface name="position"/>
      <state_interface   name="position"/>
    </joint>

    <!-- rear drive -->
    <joint name="RLMotor">
      <command_interface name="velocity"/>
      <state_interface   name="velocity"/>
      <state_interface   name="position"/>
    </joint>
    <joint name="RRMotor">
      <command_interface name="velocity"/>
      <state_interface   name="velocity"/>
      <state_interface   name="position"/>
    </joint>

    <!-- front wheels (pos only) -->
    <joint name="FLWheel"><state_interface name="position"/></joint>
    <joint name="FRWheel"><state_interface name="position"/></joint>
  </ros2_control>

</robot>
