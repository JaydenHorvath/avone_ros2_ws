<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <ros2_control name="AVONE_ros2_control" type="system">
    <hardware>
      <plugin>avone/AvoneSystemHardware</plugin>
      <param name="max_steer_angle">1.3</param>
      <param name="min_steer_angle">-1.3</param>
      <param name="max_rpm">350</param>
      <param name="can_interface">can0</param>
      <param name="can_baudrate">250000</param>
      <param name="read_timeout_ms">20</param>
      <param name="l_motor_can_id">0x8CF11E05</param>
      <!-- set right as same as left until figure out motor controller  -->
      <param name="r_motor_can_id">0x8CF11E06</param> 


      <param name="steer_can_id">0x006</param>

      <param name="cmd_l_motor_can_id">0x0B</param>
      <param name="cmd_r_motor_can_id">0x0C</param>
      <param name="cmd_steer_can_id">0x004</param>


    </hardware>

  <!-- front steering -->
  <joint name="LSteer">
    <command_interface name="position"/>
    <state_interface   name="position"/>
  </joint>
  <joint name="RSteer">
    <command_interface name="position"/>
    <state_interface   name="position"/>
  </joint>

  <!-- rear drive -->
  <joint name="RLMotor">
    <command_interface name="velocity"/>
    <state_interface   name="velocity"/>
    <state_interface   name="position"/>
  </joint>
  <joint name="RRMotor">
    <command_interface name="velocity"/>
    <state_interface   name="velocity"/>
    <state_interface   name="position"/>
  </joint>

  <!-- Front wheels just mirroring rear -->
  <joint name="FLWheel">

    <state_interface   name="position"/>

  </joint>
  <joint name="FRWheel">

    <state_interface   name="position"/>

  </joint>

</ros2_control>


 
</robot>