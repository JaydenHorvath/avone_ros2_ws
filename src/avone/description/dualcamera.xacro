<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <joint name="left_camera_joint" type="fixed">
        <parent link="chassis"/>
        <child link="left_camera_link"/>
        <origin xyz="1.5724 0.188618 0.4587" rpy="0 0 0"/>
    </joint>

    <link name="left_camera_link">
        <visual>
            <geometry>
                <box size="0.010 0.03 0.03"/>
            </geometry>
            <material name="red"/>
        </visual>
    </link>


    <joint name="left_camera_optical_joint" type="fixed">
        <parent link="left_camera_link"/>
        <child link="left_camera_link_optical"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <link name="left_camera_link_optical"></link>



    <gazebo reference="left_camera_link">
        <material>Gazebo/Red</material>

        <sensor name="left_camera" type="camera">

            <gz_frame_id>left_camera_link_optical</gz_frame_id>

            <pose> 0 0 0 0 0 0 </pose>
            <visualize>true</visualize>
            <update_rate>30</update_rate>
            <topic>rgb_left/image</topic>
            <camera>
            <camera_info_topic>rgb_left/camera_info</camera_info_topic>
                      <horizontal_fov>1.2042771838760875</horizontal_fov>
                <image>
                    <format>R8G8B8</format>
                           <width>640</width>
          <height>360</height>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>15.0</far>
                </clip>
            </camera>
           
        </sensor>

            
    </gazebo>

    <!-- LEFT DEPTH -->

      <joint name="left_depthcamera_joint" type="fixed">
        <parent link="chassis"/>
        <child link="left_depthcamera_link"/>
         <origin xyz="1.5724 0.188618 0.4587" rpy="0 0 0"/>
    </joint>

    <link name="left_depthcamera_link"/>
     


    <joint name="left_depthcamera_optical_joint" type="fixed">
        <parent link="left_depthcamera_link"/>
        <child link="left_depthcamera_link_optical"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <link name="left_depthcamera_link_optical"/>



    <gazebo reference="left_depthcamera_link">
        <material>Gazebo/Red</material>

        <sensor name="left_depthcamera" type="depth">

            <gz_frame_id>left_depthcamera_link_optical</gz_frame_id>

            <pose> 0 0 0 0 0 0 </pose>
            <visualize>true</visualize>
            <update_rate>30</update_rate>
            <topic>rgb_left/depth_image</topic>
            <camera_info_topic>rgb_left/depth_camera_info</camera_info_topic>
            <point_cloud>true</point_cloud>
            <always_on>1</always_on>
            <camera>
                <horizontal_fov>1.8</horizontal_fov>
                <image>
                    <format>R8G8B8</format>
                    <width>640</width>
                    <height>360</height>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>10.0</far>
                </clip>
            </camera>
        
        </sensor>


      
        
    </gazebo>



    <!-- RIGHT -->

    <joint name="right_camera_joint" type="fixed">
        <parent link="chassis"/>
        <child link="right_camera_link"/>
        <origin xyz="1.5724 -0.188618 0.4587" rpy="0 0 0"/>
    </joint>

    <link name="right_camera_link">
        <visual>
            <geometry>
                <box size="0.010 0.03 0.03"/>
            </geometry>
            <material name="red"/>
        </visual>
    </link>


    <joint name="right_camera_optical_joint" type="fixed">
        <parent link="right_camera_link"/>
        <child link="right_camera_link_optical"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <link name="right_camera_link_optical"></link>



    <gazebo reference="right_camera_link">
        <material>Gazebo/Red</material>

        <sensor name="right_camera" type="camera">

            <gz_frame_id>right_camera_link_optical</gz_frame_id>

            <pose> 0 0 0 0 0 0 </pose>
            <visualize>true</visualize>
            <update_rate>30</update_rate>
            <topic>rgb_right/image</topic>
            <camera>
            <camera_info_topic>rgb_right/camera_info</camera_info_topic>
                      <horizontal_fov>1.2042771838760875</horizontal_fov>
                <image>
                    <format>R8G8B8</format>
                           <width>640</width>
          <height>360</height>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>15.0</far>
                </clip>
            </camera>
           
        </sensor>

            
    </gazebo>


       <!-- LEFT DEPTH -->

      <joint name="right_depthcamera_joint" type="fixed">
        <parent link="chassis"/>
        <child link="right_depthcamera_link"/>
         <origin xyz="1.5724 -0.188618 0.4587" rpy="0 0 0"/>
    </joint>

    <link name="right_depthcamera_link"/>
     


    <joint name="right_depthcamera_optical_joint" type="fixed">
        <parent link="right_depthcamera_link"/>
        <child link="right_depthcamera_link_optical"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <link name="right_depthcamera_link_optical"/>



    <gazebo reference="right_depthcamera_link">
        <material>Gazebo/Red</material>

        <sensor name="right_depthcamera" type="depth">

            <gz_frame_id>right_depthcamera_link_optical</gz_frame_id>

            <pose> 0 0 0 0 0 0 </pose>
            <visualize>true</visualize>
            <update_rate>30</update_rate>
            <topic>rgb_right/depth_image</topic>
            <camera_info_topic>rgb_right/depth_camera_info</camera_info_topic>
            <point_cloud>true</point_cloud>
            <always_on>1</always_on>
            <camera>
                <horizontal_fov>1.8</horizontal_fov>
                <image>
                    <format>R8G8B8</format>
                    <width>640</width>
                    <height>360</height>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>10.0</far>
                </clip>
            </camera>
        
        </sensor>


      
        
    </gazebo>


</robot>