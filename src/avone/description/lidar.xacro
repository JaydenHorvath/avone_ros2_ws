<?xml version="1.0"?>
<!--
lidar.xacro

Purpose
  Defines a fixed mounted LiDAR link (laser_frame) on the chassis and attaches
  a Gazebo gpu_lidar sensor that publishes a point cloud topic.

Frames
  chassis -> laser_frame

Topics
  lidar   (Gazebo sensor topic)

Main tuning points
  laser_joint origin: mount position and aim on the chassis
  gpu_lidar scan: horizontal/vertical samples and FOV (min_angle/max_angle)
  range: min/max and range resolution
  update_rate: sensor publish frequency
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <!-- Fixed mount from chassis to the LiDAR frame -->
    <joint name="laser_joint" type="fixed">
        <parent link="chassis"/>
        <child link="laser_frame"/>
        <!-- xyz in meters, rpy in radians -->
        <origin xyz="2.244 0 0.3464" rpy="0 0 0"/>
    </joint>

    <!-- LiDAR physical frame: visual + collision + inertial -->
    <link name="laser_frame">
        <!-- Visual model used for viewing in RViz/Gazebo -->
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.090"/>
            </geometry>
            <material name="black"/>
        </visual>

        <!-- Collision geometry used by Gazebo physics -->
        <collision>
            <geometry>
                <cylinder radius="0.05" length="0.090"/>
            </geometry>
        </collision>

        <!-- Inertial approximation (requires xacro:inertial_cylinder macro defined elsewhere) -->
        <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.05">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <!-- Gazebo sensor attached to laser_frame -->
    <gazebo reference="laser_frame">
        <material>Gazebo/Black</material>

        <!-- GPU LiDAR: produces rays in a horizontal and vertical scan pattern -->
        <sensor name='gpu_lidar' type='gpu_lidar'>

            <!-- Pose relative to the reference link; keep zero if laser_joint sets mount pose -->
            <pose relative_to='laser_frame'>0 0 0 0 0 0</pose>

            <!-- Topic name published by Gazebo for this sensor -->
            <topic>lidar</topic>

            <!-- Frame id stamped into the published messages -->
            <gz_frame_id>laser_frame</gz_frame_id>

            <!-- Publish frequency (Hz) -->
            <update_rate>10</update_rate>

            <ray>
                <scan>
                    <!-- Horizontal scan: 3600 samples across approx 149 degrees (±1.3 rad) -->
                    <horizontal>
                        <samples>3600</samples>
                        <resolution>1</resolution>
                        <min_angle>-1.3</min_angle>
                        <max_angle>1.3</max_angle>
                    </horizontal>

                    <!-- Vertical scan: 8 beams across about 20 degrees total -->
                    <vertical>
                        <samples>8</samples>
                        <resolution>1</resolution>
                        <!-- -17 degrees in radians -->
                        <min_angle>-0.296705972844</min_angle>
                        <!-- +3 degrees in radians -->
                        <max_angle>0.052359877559</max_angle>
                    </vertical>
                </scan>

                <!-- Range limits and resolution -->
                <range>
                    <min>0.10</min>
                    <max>100.0</max>
                    <resolution>0.01</resolution>
                </range>
            </ray>

            <!-- Sensor enable and visualization -->
            <always_on>1</always_on>
            <visualize>true</visualize>
        </sensor>
    </gazebo>

</robot>
