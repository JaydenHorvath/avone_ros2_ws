    <model name='wall_north'>
      <pose>0 30 1 0 0 0</pose>
      <link name='link'>
        <collision name='collision'><geometry><box><size>60 0.5 2.0</size></box></geometry></collision>
        <visual name='visual'><geometry><box><size>60 0.5 2.0</size></box></geometry></visual>
      </link>
      <static>true</static>
    </model>
