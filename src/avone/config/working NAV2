# GPS WPF CHANGES:
# - amcl params where removed. They are not needed because global localization is provided
#   by an ekf node on robot_localization fusing gps data with local odometry sources
# - static layer is removed from both costmaps, in this tutorial we assume there is no map
#   of the environment
# - global costmap is set to be rolling to allow the robot to traverse big environment by
#   following successive relatively close waypoints that fit in a smaller rolling costmap

bt_navigator:
  ros__parameters:
    use_sim_time: true              # if you’re in Gazebo or replaying bags
    global_frame: map               # frame your goals are expressed in
    robot_base_frame: base_link     # your robot’s footprint frame
    odom_topic: /odometry/global    # where to get your velocity
    # odom_topic: /ackermann_steering_controller/odometry
    # how often the BT engine ticks
    bt_loop_duration: 10          # seconds

    drive_on_heading:
          acceleration_limit: 1.0    # max m/s² you want
          deceleration_limit: -2.0   # min (negative) m/s² you want
          minimum_speed: 0.05 

    backup:
      acceleration_limit: 1.0
      deceleration_limit: -2.0
      minimum_speed: 0.05  

    # which navigator plugins to load
    navigators: ["navigate_to_pose"]

    # configure the one navigator you want
    navigate_to_pose:
      plugin: "nav2_bt_navigator/NavigateToPoseNavigator"

controller_server:
  ros__parameters:
    controller_frequency: 20.0
    min_x_velocity_threshold: 0.001
    min_y_velocity_threshold: 0.5
    min_theta_velocity_threshold: 0.001
    failure_tolerance: 0.3
    progress_checker_plugins: ["progress_checker"]
    goal_checker_plugins: ["general_goal_checker"] # "precise_goal_checker"
    controller_plugins: ["FollowPath"]

    # Progress checker parameters
    progress_checker:
      plugin: "nav2_controller::SimpleProgressChecker"
      required_movement_radius: 0.5
      movement_time_allowance: 10.0
    # Goal checker parameters
    #precise_goal_checker:
    #  plugin: "nav2_controller::SimpleGoalChecker"
    #  xy_goal_tolerance: 0.25
    #  yaw_goal_tolerance: 0.25
    #  stateful: True
    general_goal_checker:
      stateful: True
      plugin: "nav2_controller::SimpleGoalChecker"
      stateful: True
      xy_goal_tolerance:    0.4     # keep your distance tolerance
      yaw_goal_tolerance:   3.14     # allow any heading
      # latch_xy_goal_tolerance: True  # once inside XY tol, latch successful
    # DWB parameters
    FollowPath:
      plugin: "nav2_regulated_pure_pursuit_controller::RegulatedPurePursuitController"
      # Pure Pursuit tuning
      proportional_speed: true         # enable scaling
      deceleration_distance: 5.0  
      min_speed: 0.05                  # m/s
      max_speed: 2.0                   # m/s
        # 1) Look‑ahead tuning
      desired_linear_vel: 2.0
      lookahead_dist: 6.0
      min_lookahead_dist: 2.0
      max_lookahead_dist: 10.0
      lookahead_time: 2.5
      allow_reversing: False

      use_regulated_linear_velocity_scaling: True
      use_cost_regulated_linear_velocity_scaling: True

      regulated_linear_scaling_min_radius: 6.0
      regulated_linear_scaling_min_speed: 0.5

      inflation_cost_scaling_factor: 10.0

      rotate_to_heading_angular_vel: 0.2

      # kinematic limits
      max_vel_x: 0.8
      max_vel_theta: 0.3
      acc_lim_x: 0.3
      decel_lim_x: -4.0
      max_angular_accel: 0.7

      # goal tolerances
      xy_goal_tolerance: 0.5
      yaw_goal_tolerance: 1.0

# GPS WPF CHANGE: Remove static layer
local_costmap:
  local_costmap:
    ros__parameters:

      footprint: "[
        [-0.17, -0.744],
        [ 2.445, -0.744],
        [ 2.445,  0.744],
        [-0.17,  0.744]
      ]"
      update_frequency: 5.0
      publish_frequency: 2.0
      global_frame: odom
      robot_base_frame: base_link
      rolling_window: true
      width: 30
      height: 30
      resolution: 0.05
      robot_radius: 1.0

      plugins: ["voxel_layer", "inflation_layer"]

      voxel_layer:
        plugin: "nav2_costmap_2d::VoxelLayer"
        enabled: True
        publish_voxel_map: True   # set True if you want to RViz-visualize global voxels
        # vertical slab from ground (0.0) up to ~3.2 m
        origin_z:           0.0        # start marking at ground level
        z_resolution:       0.2        # each voxel is 20 cm tall
        z_voxels:           16         # 16 slices → covers 3.2 m above origin
        max_obstacle_height: 3.2        # anything above origin_z up to here

        # any single hit flips a voxel occupied
        mark_threshold:     1          # ≥1 occupied voxel → mark cell occupied
        unknown_threshold:  2147483647 # never auto‑clear by empty space
        combination_method: 1          # use “max” merge (default)

        # distance the layer will consider your pointcloud
        obstacle_max_range: 50.0       # adjust to your LiDAR’s max range
        raytrace_max_range: 50.0
       
        observation_sources: pointcloud

        pointcloud:
          # topic: /quanergy/points
          topic: /lidar/points
          data_type: PointCloud2
          sensor_frame: ""     # default to the message’s frame_id
          marking: true
          clearing: true      # we handle clearing via unknown_threshold
          min_obstacle_height: 0.0
          max_obstacle_height: 3.2
          obstacle_max_range: 50.0
          raytrace_max_range: 50.0

      inflation_layer:
        plugin: "nav2_costmap_2d::InflationLayer"
        inflation_radius: 1.0
        cost_scaling_factor: 5.0


# GPS WPF CHANGE: Remove static layer
# GPS WPF CHANGE: Set rolling global costmap with 50x50 size. See note below
global_costmap:
  global_costmap:
    ros__parameters:


      footprint: "[
        [-0.17, -0.744],
        [ 2.445, -0.744],
        [ 2.445,  0.744],
        [-0.17,  0.744]
      ]"
      update_frequency: 1.0
      publish_frequency: 1.0
      global_frame: map
      robot_base_frame: base_link
      robot_radius: 1.0
      resolution: 0.1
      # When using GPS navigation you will potentially traverse goal environments which are not practical to
      # fit on a big static costmap. Thus it is recommended to use a rolling global costmap large enough to
      # contain each pair of successive waypoints. See: https://github.com/ros-planning/navigation2/issues/2174
      rolling_window: True
      width: 100
      height: 100
      track_unknown_space: false

      plugins: ["voxel_layer", "inflation_layer"]

      voxel_layer:
        plugin: "nav2_costmap_2d::VoxelLayer"
        enabled: True
        publish_voxel_map: True   # set True if you want to RViz-visualize global voxels
        # vertical slab from ground (0.0) up to ~3.2 m
        origin_z:           0.0        # start marking at ground level
        z_resolution:       0.2        # each voxel is 20 cm tall
        z_voxels:           16         # 16 slices → covers 3.2 m above origin
        max_obstacle_height: 3.2        # anything above origin_z up to here

        # any single hit flips a voxel occupied
        mark_threshold:     1          # ≥1 occupied voxel → mark cell occupied
        unknown_threshold:  2147483647 # never auto‑clear by empty space
        combination_method: 1          # use “max” merge (default)

        # distance the layer will consider your pointcloud
        obstacle_max_range: 50.0       # adjust to your LiDAR’s max range
        raytrace_max_range: 50.0
       
        observation_sources: pointcloud

        pointcloud:
          # topic: /quanergy/points
          topic: /lidar/points
          data_type: PointCloud2
          sensor_frame: ""     # default to the message’s frame_id
          marking: true
          clearing: true      # we handle clearing via unknown_threshold
          min_obstacle_height: 0.0
          max_obstacle_height: 3.2
          obstacle_max_range: 50.0
          raytrace_max_range: 50.0

      inflation_layer:
        plugin: "nav2_costmap_2d::InflationLayer"
        inflation_radius: 1.0
        cost_scaling_factor: 5.0


map_saver:
  ros__parameters:
    save_map_timeout: 5.0
    free_thresh_default: 0.25
    occupied_thresh_default: 0.65
    map_subscribe_transient_local: True

planner_server:
  ros__parameters:
    planner_plugins: ["GridBased"]
    GridBased:
      plugin: "nav2_navfn_planner/NavfnPlanner"
      use_astar: true            # use A* on your costmap
      allow_unknown: true       # don’t path through unknown cells
      tolerance: 0.2            # goal tolerance (m)


smoother_server:
  ros__parameters:
    smoother_plugins: ["simple_smoother"]
    simple_smoother:
      plugin: "nav2_smoother::SimpleSmoother"
      tolerance: 1.0e-10
      max_its: 1000
      do_refinement: True

behavior_server:
  ros__parameters:
    local_costmap_topic: local_costmap/costmap_raw
    global_costmap_topic: global_costmap/costmap_raw
    local_footprint_topic: local_costmap/published_footprint
    global_footprint_topic: global_costmap/published_footprint
    cycle_frequency: 10.0
    behavior_plugins: ["spin", "backup", "drive_on_heading", "assisted_teleop", "wait"]
    spin:
      plugin: "nav2_behaviors/Spin"
    backup:
      plugin: "nav2_behaviors/BackUp"
    drive_on_heading:
      plugin: "nav2_behaviors/DriveOnHeading"
    wait:
      plugin: "nav2_behaviors/Wait"
    assisted_teleop:
      plugin: "nav2_behaviors/AssistedTeleop"
    local_frame: odom
    global_frame: map
    robot_base_frame: base_link
    transform_tolerance: 0.1
    simulate_ahead_time: 2.0
    max_rotational_vel: 2.0
    min_rotational_vel: 0.4
    rotational_acc_lim: 3.2

waypoint_follower:
  ros__parameters:
    loop_rate: 20
    stop_on_failure: false
    waypoint_task_executor_plugin: "wait_at_waypoint"
    wait_at_waypoint:
      plugin: "nav2_waypoint_follower::WaitAtWaypoint"
      enabled: True
      waypoint_pause_duration: 200

velocity_smoother:
  ros__parameters:
    smoothing_frequency: 20.0
    scale_velocities: False
    feedback: "OPEN_LOOP"
    max_velocity: [10.0, 0.0, 1.0]
    min_velocity: [-10.0, 0.0, -1.0]
    max_accel: [2.0, 0.0, 0.5]
    max_decel: [-2.0, 0.0, -0.5]
    # odom_topic: /ackermann_steering_controller/odometry
    odom_topic: /odometry/global 
    odom_duration: 0.1
    deadband_velocity: [0.02, 0.0, 0.0]
    velocity_timeout: 0.05