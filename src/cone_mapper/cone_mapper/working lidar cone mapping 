#!/usr/bin/env python3

import rclpy
from rclpy.node import Node
from rclpy.time import Time
from rclpy.duration import Duration

from sensor_msgs.msg import PointCloud2
from sensor_msgs_py import point_cloud2
from visualization_msgs.msg import Marker, MarkerArray
from geometry_msgs.msg import PointStamped

import numpy as np
import pcl

import tf2_ros
from tf2_geometry_msgs import do_transform_point
from tf2_ros import TransformException


class LidarConeMapper(Node):
    def __init__(self):
        super().__init__('lidar_cone_mapper')

        # RANSAC ground‐plane parameters
        self.ground_distance_threshold = 0.02  # 2 cm

        # clustering parameters
        self.cluster_tol     = 0.20  # 20 cm
        self.min_cluster_pts = 10
        self.max_cluster_pts = 2000

        # horizontal dedupe (vertical filter) tolerance
        self.xy_merge_tol = 0.20  # 20 cm in XY to treat as same cone

        # TF setup
        self.world_frame = 'map'
        self.tf_buffer   = tf2_ros.Buffer()
        self.tf_listener = tf2_ros.TransformListener(self.tf_buffer, self)

        # subscription + publishers
        self.create_subscription(PointCloud2,
                                 '/lidar/points',
                                 self.cloud_cb,
                                 5)
        # publishes the filtered (no‐ground) cloud
        self.filtered_pub = self.create_publisher(PointCloud2,
                                                  '/filtered_cloud',
                                                  10)
        # publishes cone centroids as markers
        self.marker_pub   = self.create_publisher(MarkerArray,
                                                  '/cone_landmarks',
                                                  10)

        self.get_logger().info('[LidarConeMapper] ready.')

    def cloud_cb(self, msg: PointCloud2):
        # 1) Read everything (including NaNs), then drop invalid points
        all_pts = np.array([
            (x, y, z)
            for (x, y, z) in point_cloud2.read_points(
                msg,
                field_names=('x', 'y', 'z'),
                skip_nans=False
            )
        ], dtype=np.float32)
        if all_pts.size == 0:
            return

        finite_mask = np.isfinite(all_pts).all(axis=1)
        pts = all_pts[finite_mask]
        if pts.shape[0] < self.min_cluster_pts:
            return

        # 2) RANSAC‐plane fit → remove ground inliers
        cloud = pcl.PointCloud(pts)
        seg   = cloud.make_segmenter_normals(ksearch=50)
        seg.set_model_type(pcl.SACMODEL_PLANE)
        seg.set_method_type(pcl.SAC_RANSAC)
        seg.set_distance_threshold(self.ground_distance_threshold)
        inliers, _ = seg.segment()
        if not inliers:
            return

        non_ground = np.ones(len(pts), dtype=bool)
        non_ground[inliers] = False
        pts_noground = pts[non_ground]
        if pts_noground.shape[0] < self.min_cluster_pts:
            return

        # --- new: publish the filtered pointcloud ---
        filtered_msg = point_cloud2.create_cloud_xyz32(
            msg.header,
            pts_noground.tolist()
        )
        self.filtered_pub.publish(filtered_msg)

        # 3) Euclidean clustering in LiDAR frame
        tree = pcl.PointCloud(pts_noground).make_kdtree()
        ec   = pcl.PointCloud(pts_noground).make_EuclideanClusterExtraction()
        ec.set_ClusterTolerance(self.cluster_tol)
        ec.set_MinClusterSize(self.min_cluster_pts)
        ec.set_MaxClusterSize(self.max_cluster_pts)
        ec.set_SearchMethod(tree)
        clusters = ec.Extract()
        if not clusters:
            return

        # 4) Compute centroids in LiDAR frame
        centroids = [pts_noground[idx_list].mean(axis=0) for idx_list in clusters]

        # 5) Vertical filter (dedupe by XY)
        unique_centroids = []
        for c in centroids:
            xy = c[:2]
            if not any(np.linalg.norm(xy - uc[:2]) < self.xy_merge_tol
                       for uc in unique_centroids):
                unique_centroids.append(c)
        if not unique_centroids:
            return

        # 6) Lookup latest TF (LiDAR → map)
        try:
            tf_cam_to_world = self.tf_buffer.lookup_transform(
                self.world_frame,
                msg.header.frame_id,
                Time(),                            # zero → “latest”
                timeout=Duration(seconds=0.1)
            )
        except TransformException as e:
            self.get_logger().warn(f"[LidarConeMapper] TF lookup failed: {e}")
            return

        # 7) Build & publish markers for each unique centroid
        ma = MarkerArray()
        now_msg = self.get_clock().now().to_msg()

        for idx, cent in enumerate(unique_centroids):
            p_cam = PointStamped()
            p_cam.header.frame_id = msg.header.frame_id
            p_cam.header.stamp    = now_msg
            p_cam.point.x, p_cam.point.y, p_cam.point.z = cent.tolist()

            try:
                p_world = do_transform_point(p_cam, tf_cam_to_world)
            except TransformException as e:
                self.get_logger().warn(f"[LidarConeMapper] TF transform failed: {e}")
                continue

            m = Marker()
            m.header.frame_id = self.world_frame
            m.header.stamp    = now_msg
            m.ns              = 'cones'
            m.id              = idx
            m.type            = Marker.SPHERE
            m.action          = Marker.ADD
            m.pose.position   = p_world.point
            m.scale.x = m.scale.y = m.scale.z = 0.30
            m.color.r = 1.0
            m.color.g = 0.0
            m.color.b = 0.0
            m.color.a = 0.8
            ma.markers.append(m)

        self.marker_pub.publish(ma)


def main(args=None):
    rclpy.init(args=args)
    node = LidarConeMapper()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
