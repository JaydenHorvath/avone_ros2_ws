#!/usr/bin/env python3

import rclpy
from rclpy.node import Node
from sensor_msgs.msg import Image, CameraInfo
from vision_msgs.msg import Detection2DArray, Detection2D, BoundingBox2D, ObjectHypothesisWithPose
from geometry_msgs.msg import PoseArray, Pose
from cv_bridge import CvBridge
from ultralytics import YOLO
import numpy as np
import cv2

class YoloRosNode(Node):
    def __init__(self):
        super().__init__('yolo_ros_node')
        self.bridge = CvBridge()

        # Paths and parameters
        weights_path = '/home/jay/Documents/yolo11-tutorial/runs/detect/train18/weights/best.pt'
        self.model = YOLO(weights_path)

        # Mapping class IDs → readable labels
        self.color_map = {0: 'blue', 1: 'orange', 2: 'orange', 4: 'yellow'}
        # Real-world cone heights (m)
        self.height_map = {'blue': 0.325, 'yellow': 0.325, 'orange': 0.325}

        # Camera intrinsics (filled on first CameraInfo)
        self.fx = self.fy = self.cx = self.cy = None

        # Subscribers
        self.create_subscription(
            CameraInfo,
            '/camera/camera/color/camera_info',
            self.caminfo_cb,
            10
        )
        self.create_subscription(
            Image,
            '/camera/camera/color/image_raw',
            self.image_cb,
            10
        )

        # Publishers
        self.info_pub = self.create_publisher(CameraInfo, '/yolo/camera_info', 10)
        self.det_pub  = self.create_publisher(Detection2DArray, '/yolo/detections', 10)
        self.pose_pub = self.create_publisher(PoseArray, '/cone_poses', 10)
        self.image_pub = self.create_publisher(Image, '/yolo/image', 10)

        self.get_logger().info('YOLO detection node with depth estimation started')

    def caminfo_cb(self, msg: CameraInfo):
        # Capture intrinsics once
        if self.fx is None:
            self.fx = msg.k[0]
            self.fy = msg.k[4]
            self.cx = msg.k[2]
            self.cy = msg.k[5]
            self.get_logger().info(f"Captured intrinsics fx={self.fx}, fy={self.fy}, cx={self.cx}, cy={self.cy}")
        # Republish camera_info
        self.info_pub.publish(msg)

    def image_cb(self, img_msg: Image):
        # Convert ROS Image to OpenCV
        try:
            frame = self.bridge.imgmsg_to_cv2(img_msg, 'bgr8')
        except Exception as e:
            self.get_logger().error(f"cv_bridge error: {e}")
            return

        # Run YOLO inference
        results = self.model(frame)[0]

        # Prepare ROS messages
        det_arr = Detection2DArray()
        det_arr.header = img_msg.header
        pose_arr = PoseArray()
        pose_arr.header = img_msg.header

        vis = frame.copy()

        for box in results.boxes:
            x1, y1, x2, y2 = box.xyxy[0].tolist()
            conf = float(box.conf[0].item())
            cls_id = int(box.cls[0].item())
            label = self.color_map.get(cls_id, 'unknown')

            # Compute depth Z from bounding-box height if intrinsics available
            h = y2 - y1
            if self.fx and label in self.height_map and h > 0:
                Z = (self.fy * self.height_map[label]) / h
                u = (x1 + x2) / 2.0
                v = (y1 + y2) / 2.0
                X = (u - self.cx) * Z / self.fx
                Y = (v - self.cy) * Z / self.fy
            else:
                X = 0.0; Y = 0.0; Z = float(h)

            # Draw on image
            color = (255,0,0) if label=='blue' else ((0,255,255) if label=='yellow' else (0,165,255))
            cv2.rectangle(vis, (int(x1), int(y1)), (int(x2), int(y2)), color, 2)
            cv2.putText(vis, f"{label} {Z:.2f}m", (int(x1), int(y1)-10), cv2.FONT_HERSHEY_SIMPLEX, 0.5, color, 2)

            # Populate Detection2D
            d2 = Detection2D()
            d2.header = img_msg.header
            bb = BoundingBox2D()
            bb.center.position.x = (x1 + x2) / 2.0
            bb.center.position.y = (y1 + y2) / 2.0
            bb.size_x = x2 - x1
            bb.size_y = y2 - y1
            d2.bbox = bb

            hyp = ObjectHypothesisWithPose()
            hyp.hypothesis.class_id = label
            hyp.hypothesis.score = conf
            hyp.pose.pose.position.x = float(X)
            hyp.pose.pose.position.y = float(Y)
            hyp.pose.pose.position.z = float(Z)
            hyp.pose.pose.orientation.w = 1.0
            d2.results = [hyp]

            det_arr.detections.append(d2)

            # Populate PoseArray
            pose = Pose()
            pose.position.x = float(X)
            pose.position.y = float(Y)
            pose.position.z = float(Z)
            pose.orientation.w = 1.0
            pose_arr.poses.append(pose)

        # Publish all
        img_out = self.bridge.cv2_to_imgmsg(vis, 'bgr8')
        img_out.header = img_msg.header
        self.image_pub.publish(img_out)
        self.det_pub.publish(det_arr)
        self.pose_pub.publish(pose_arr)


def main(args=None):
    rclpy.init(args=args)
    node = YoloRosNode()
    try:
        rclpy.spin(node)
    finally:
        node.destroy_node()
        rclpy.shutdown()

if __name__ == '__main__':
    main()
