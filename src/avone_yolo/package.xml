<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>avone_yolo</name>
  <version>0.0.0</version>
  <description>AVONES YOLO Cone Detection Package</description>
  <maintainer email="c3350128@uon.edu.au">jay</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>cv_bridge</depend>
   <build_depend>geometry_msgs</build_depend>
  <build_depend>vision_msgs</build_depend>
  
  
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
    <exec_depend>transformers</exec_depend>
  <exec_depend>torch</exec_depend>


  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <exec_depend>vision_msgs</exec_depend>

  <depend>tf2_sensor_msgs</depend>
  <depend>tf2_ros</depend>     

  <export>
    <build_type>ament_python</build_type>
  </export>
